# Copy to .env and fill in. Never commit .env.

# --- Core ---
ENVIRONMENT=development
# SQLite for local dev. Docker Compose overrides this with its own PostgreSQL URL.
DATABASE_URL=sqlite:///./health_tracker.db
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:8501
# Shared secret between frontend and API (sent as X-API-Key). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Docker Compose only ---
POSTGRES_PASSWORD=change-me

# --- Optional: LLM assistant (Groq). Without a key the rule-based assistant is used. ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional: SMS / WhatsApp via Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Optional: email via SMTP (for Gmail use an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
